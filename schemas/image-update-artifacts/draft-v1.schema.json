{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faviann.github.io/homelab-iac/schemas/image-update-artifacts/draft-v1.schema.json",
  "title": "Image update planning draft artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_kind", "assessment_requests", "created_at", "evidence", "expires_at", "input_fingerprints", "repository", "schema_version", "source_commit"],
  "properties": {
    "artifact_kind": {"const": "draft"},
    "schema_version": {"const": 1},
    "created_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"},
    "expires_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+(?![\\s\\S])"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}(?![\\s\\S])"},
    "input_fingerprints": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^stacks/[^/\\r\\n]+/[^/\\r\\n]+(?![\\s\\S])"},
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"}
    },
    "evidence": {"$ref": "#/$defs/evidence"},
    "assessment_requests": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["stack", "question", "evidence_ids"],
        "properties": {
          "stack": {"type": "string", "pattern": "^stacks/[^/\\r\\n]+/[^/\\r\\n]+(?![\\s\\S])"},
          "question": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "stack", "service", "current_image", "candidate_image", "reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "stack": {"type": "string", "pattern": "^stacks/[^/\\r\\n]+/[^/\\r\\n]+(?![\\s\\S])"},
          "service": {"type": "string", "minLength": 1},
          "current_image": {"type": "string", "minLength": 1},
          "candidate_image": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
