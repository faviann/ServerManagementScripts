{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faviann.vms/schemas/image-update-renovate-adapter/renovate-raw-record-v1",
  "type": "object",
  "required": ["level", "msg", "config"],
  "properties": {
    "level": {"const": 20},
    "msg": {"const": "packageFiles with updates"},
    "config": {
      "type": "object",
      "required": ["docker-compose"],
      "properties": {
        "docker-compose": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["packageFile", "deps"],
            "properties": {
              "packageFile": {"type": "string"},
              "deps": {"type": "array", "minItems": 1, "maxItems": 1}
            }
          }
        }
      }
    }
  },
  "description": "Unconsumed Renovate fields are tolerated. The adapter closes and validates every consumed field and checks the exact Renovate started record separately."
}
