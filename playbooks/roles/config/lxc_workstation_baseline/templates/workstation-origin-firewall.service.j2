[Unit]
Description=Workstation origin firewall
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nftables.d/workstation-origin-firewall.nft
ExecStop=/usr/sbin/nft delete table inet workstation_origin

[Install]
WantedBy=multi-user.target
